# Node Environment
NODE_ENV=development

# Razorpay Payment Gateway (Test or Live keys)
# Get keys at: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE

# Customer & Admin JWT Authentication Secret
JWT_SECRET=sumant_handmade_doormat_secret_key_2026_secure

# Store Public Branding
NEXT_PUBLIC_STORE_NAME="Home Warrior"
NEXT_PUBLIC_WHATSAPP_NUMBER="918878112007"

# MongoDB Atlas Cloud Database (Permanent Storage for Customers, Orders, Admin)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sumant_crafts?retryWrites=true&w=majority"
MONGODB_DB="sumant_crafts"

# Zoho Mail SMTP Service (Customer Registration OTP & Order Invoices)
ZOHO_MAIL_USER="sumantku2509@zohomail.in"
ZOHO_MAIL_APP_PASSWORD=""
SMTP_HOST="smtp.zoho.in"
SMTP_PORT=465

# Gmail SMTP Backup (OTP Verification Service)
GMAIL_USER="your_backup_email@gmail.com"
